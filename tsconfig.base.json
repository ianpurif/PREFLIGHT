{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rovaulta/domain": ["packages/domain/src/index.ts"],
      "@rovaulta/simulation-core": ["packages/simulation-core/src/index.ts"],
      "@rovaulta/ledger-gate": ["packages/ledger-gate/src/index.ts"],
      "@rovaulta/chain-client": ["packages/chain-client/src/index.ts"],
      "@rovaulta/chainlink-cre/*": ["integrations/chainlink-cre/src/*"]
    }
  }
}
