{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "Rovaulta Release Gate",
    "eip712": {
      "domain": {
        "name": "Rovaulta",
        "version": "1"
      },
      "deployments": [
        {
          "chainId": 11155111,
          "address": "0xFB270cc222efa8B5005AA097dD512Be2558dde65"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Rovaulta",
    "contractName": "Rovaulta Release Gate"
  },
  "display": {
    "formats": {
      "DeploymentIntent(string protocolVersion,string schemaVersion,string action,string siteId,string robotId,string robotBuildId,bytes32 robotBuildDigest,string clearanceId,bytes32 clearanceDigest,string targetEnvironment,address authorizedSigner,string nonce,uint64 issuedAt,uint64 expiresAt,bytes32 protocolIntentDigest)": {
        "$id": "Exact cleared robot release",
        "intent": "Authorize robot release",
        "fields": [
          { "path": "protocolVersion", "label": "Protocol", "format": "raw", "visible": "always" },
          {
            "path": "schemaVersion",
            "label": "Intent schema",
            "format": "raw",
            "visible": "always"
          },
          { "path": "action", "label": "Action", "format": "raw", "visible": "always" },
          { "path": "siteId", "label": "Site", "format": "raw", "visible": "always" },
          { "path": "robotId", "label": "Robot", "format": "raw", "visible": "always" },
          { "path": "robotBuildId", "label": "Build", "format": "raw", "visible": "always" },
          {
            "path": "robotBuildDigest",
            "label": "Build digest",
            "format": "raw",
            "visible": "always"
          },
          { "path": "clearanceId", "label": "Clearance", "format": "raw", "visible": "always" },
          {
            "path": "clearanceDigest",
            "label": "Clearance digest",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "targetEnvironment",
            "label": "Environment",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "authorizedSigner",
            "label": "Authorized signer",
            "format": "addressName",
            "params": { "types": ["eoa"] },
            "visible": "always"
          },
          { "path": "nonce", "label": "One-time nonce", "format": "raw", "visible": "always" },
          {
            "path": "issuedAt",
            "label": "Issued at",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "visible": "always"
          },
          {
            "path": "expiresAt",
            "label": "Expires at",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "visible": "always"
          },
          {
            "path": "protocolIntentDigest",
            "label": "Intent digest",
            "format": "raw",
            "visible": "always"
          }
        ]
      }
    }
  }
}
