{
  "name": "preflight",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.2.21"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "overrides": {
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "demo:setup": "bun run scripts/p7-demo.mjs setup",
    "demo:reset": "bun run scripts/p7-demo.mjs reset",
    "demo:run": "bun run scripts/p7-demo.mjs run",
    "demo:rehearse": "playwright test tests/e2e/p7-deterministic-demo.spec.ts",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "doctor": "node scripts/doctor.mjs",
    "verify:scaffold": "node scripts/verify-scaffold.mjs && node --test scripts/scaffold.test.mjs",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build && bun run contracts:test && bun run verify:scaffold"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.62.1",
    "turbo": "2.10.12",
    "typescript": "5.9.2",
    "@types/bun": "1.4.0"
  }
}
