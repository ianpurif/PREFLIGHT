# Copy to .env.local. Never commit real values.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Local account-backed application state. The policy key file is ignored; set the hex key explicitly
# in shared/production environments instead of relying on a local generated file.
ROVAULTA_APP_DB_PATH=.data/rovaulta-app.sqlite
ROVAULTA_POLICY_KEY_PATH=.data/rovaulta-policy.key
ROVAULTA_POLICY_ENCRYPTION_KEY=
# Optional Build Integrity runner. Docker/buildx is required only for `Build From Source`; existing
# build-number records do not use these settings. The runner resolves image tags to immutable digests.
ROVAULTA_BUILD_ARTIFACT_DIR=.data/rovaulta-build-artifacts
# Host-side Docker CLI used by the API process. Docker/BuildKit and its daemon are never run
# inside the API process; on Windows this may be an absolute Docker Desktop docker.exe path.
ROVAULTA_BUILD_DOCKER_BINARY=docker
# Optional host-side Docker connection/configuration variables. They are used only by the Docker
# CLI and are not passed into the untrusted source-build container.
# DOCKER_HOST=
# DOCKER_CONTEXT=
# DOCKER_CONFIG=
ROVAULTA_BUILD_TIMEOUT_SECONDS=900
ROVAULTA_BUILD_MEMORY=1g
ROVAULTA_BUILD_CPU_QUOTA=50000
ROVAULTA_BUILD_CPU_PERIOD=100000
ROVAULTA_BUILD_PLATFORM=linux/amd64
ROVAULTA_BUILD_SOURCE_HOSTS=github.com,gitlab.com
ROVAULTA_BUILD_BUN_IMAGE=oven/bun:1.4.1
ROVAULTA_BUILD_NODE_IMAGE=node:22-bookworm-slim
ROVAULTA_BUILD_DOCKERFILE_FRONTEND=docker/dockerfile:1.7
ROVAULTA_BUILD_BUILDKIT_IMAGE=moby/buildkit:v0.30.0
# `none` is the fail-closed default. Use `default` only with a dedicated BuildKit
# daemon whose egress is restricted to the approved package registries/proxy.
ROVAULTA_BUILD_INSTALL_NETWORK=none
ROVAULTA_BUILD_MAX_CONCURRENT=2
ROVAULTA_BUILD_MAX_SOURCE_ENTRIES=50000
ROVAULTA_BUILD_MAX_SOURCE_BYTES=536870912
# Development/regression fixture only; leave unset for the normal product.
ROVAULTA_ENABLE_DEMO_ROUTES=
# Optional public signer address used to address the existing P5.2 preparation API. Never put a private key here.
NEXT_PUBLIC_P6_SIGNER_ADDRESS=

# Sepolia-first EVM wiring (implementation phase)
EVM_CHAIN_ID=11155111
EVM_RPC_URL=

# P4 Sepolia deployment. Keep the private key and explorer key local and unfunded on mainnet.
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Chainlink CRE metadata only. Put secrets in the CRE-supported secret store, not here.
ROVAULTA_CRE_EXECUTION_MODE=gateway
CHAINLINK_CRE_WORKFLOW_ID=
CHAINLINK_CRE_TARGET=staging-settings
ROVAULTA_CRE_GATEWAY_URL=https://01.enterprise-gateway.zone-a.cre.chain.link/
CHAINLINK_CRE_TRIGGER_PRIVATE_KEY=
# API-only HMAC key shared with the CRE TEE result-delivery secret. Never expose to the browser.
ROVAULTA_CRE_RESULT_CALLBACK_SECRET=

# P13 operator runner. These values are read only by the local HTTP runner; the setup file must
# stay under ignored .data/ and may contain the private site policy. The runner never prints it.
ROVAULTA_P13_API_ORIGIN=http://localhost:4000
ROVAULTA_P13_WEB_ORIGIN=http://localhost:3000
ROVAULTA_P13_EMAIL=
# Use the exact existing account password; API accepts 12-256 characters and the runner never prints it.
ROVAULTA_P13_PASSWORD=
# Set to .data/p13-setup.json only for setup-only mode; leave empty when reusing IDs.
ROVAULTA_P13_SETUP_PATH=
ROVAULTA_P13_SETUP_ONLY=false
ROVAULTA_P13_ACCOUNT_ID=
ROVAULTA_P13_SITE_ID=
ROVAULTA_P13_ROBOT_ID=
ROVAULTA_P13_BUILD_ID=
ROVAULTA_P13_EVIDENCE_PATH=
ROVAULTA_P13_POLL_ATTEMPTS=30
ROVAULTA_P13_POLL_DELAY_MS=2000
# Operator-only CRE CLI provisioning. The secret value is supplied in-memory to the CLI and is
# never written to this file, the API, browser output, or committed evidence.
ROVAULTA_CRE_TARGET=staging-settings
ROVAULTA_CRE_CLI=cre
# Authorization mode only (auto or browser), not a credential.
ROVAULTA_CRE_SECRETS_AUTH=

# The Graph Sepolia provider. Keys are server-side only; never expose them as NEXT_PUBLIC_*.
THE_GRAPH_API_KEY=
THE_GRAPH_SUBGRAPH_ID=
THE_GRAPH_API_URL=https://gateway.thegraph.com/api
# Optional explicit Subgraph Studio query endpoint for live hosted evidence when the deployment
# has not been published to the Gateway. Keep this server-side; it contains no API credential.
THE_GRAPH_STUDIO_QUERY_URL=
# Operator-only Subgraph Studio deployment; never expose or commit the deploy key.
GRAPH_SUBGRAPH_SLUG=
GRAPH_DEPLOY_KEY=
GRAPH_VERSION_LABEL=0.1.0
# Operator-only live qualification input. The clearance file contains public P4 fields only.
ROVAULTA_P11_ACCOUNT_ID=
ROVAULTA_P11_CLEARANCE_PATH=
ROVAULTA_P11_SIGNER_ADDRESS=

# Operator-only real clearance issuance. The account/evaluation must already exist in the API
# database and have a public CLEAR result. The registrar key is never returned or committed.
SEPOLIA_REGISTRAR_PRIVATE_KEY=
ROVAULTA_CLEARANCE_CONFIRM=
ROVAULTA_CLEARANCE_ACCOUNT_ID=
ROVAULTA_CLEARANCE_EVALUATION_ID=
ROVAULTA_CLEARANCE_ID=
ROVAULTA_CLEARANCE_TTL_SECONDS=604800
ROVAULTA_CLEARANCE_OUTPUT_PATH=

# Ledger DMK configuration. Origin token is partner-provided if/when required.
# Production default: webhid. Speculos is rejected unless NODE_ENV is development or test.
# Its deterministic signer must never be placed in a production allowlist.
NEXT_PUBLIC_LEDGER_TRANSPORT=webhid
NEXT_PUBLIC_LEDGER_SPECULOS_URL=http://127.0.0.1:5000
NEXT_PUBLIC_LEDGER_ORIGIN_TOKEN=
NEXT_PUBLIC_LEDGER_DERIVATION_PATH=44'/60'/0'/0/0

# P5 public authorization policy and durable single-node replay store.
# The registry address/chain come only from contracts/deployments/sepolia.json.
ROVAULTA_AUTHORIZED_SIGNERS=
ROVAULTA_RELEASE_DB_PATH=.data/rovaulta-release.sqlite
ROVAULTA_INTENT_TTL_SECONDS=300

# P5.2 narrow deployment-agent provider. The catalog contains public canonical targets and complete
# public clearance records only; never put an envelope, blind, credential, or signature in it.
# Gemini is server-side only; no mock fallback is used when these are absent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ROVAULTA_AGENT_CATALOG_PATH=
