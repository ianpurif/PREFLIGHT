# Copy to .env.local. Never commit real values.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Sepolia-first EVM wiring (implementation phase)
EVM_CHAIN_ID=11155111
EVM_RPC_URL=

# P4 Sepolia deployment. Keep the private key and explorer key local and unfunded on mainnet.
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Chainlink CRE metadata only. Put secrets in the CRE-supported secret store, not here.
CHAINLINK_CRE_WORKFLOW_ID=
CHAINLINK_CRE_TARGET=staging-settings

# Ledger DMK configuration. Origin token is partner-provided if/when required.
NEXT_PUBLIC_LEDGER_ORIGIN_TOKEN=
NEXT_PUBLIC_LEDGER_DERIVATION_PATH=44'/60'/0'/0/0

# P5 public authorization policy and durable single-node replay store.
# The registry address/chain come only from contracts/deployments/sepolia.json.
PREFLIGHT_AUTHORIZED_SIGNERS=
PREFLIGHT_RELEASE_DB_PATH=.data/preflight-release.sqlite
PREFLIGHT_INTENT_TTL_SECONDS=300
